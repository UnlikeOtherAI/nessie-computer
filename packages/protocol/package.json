{
  "name": "@nessie/executor-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./t3-session": {
      "types": "./dist/t3-session/index.d.ts",
      "default": "./dist/t3-session/index.js"
    },
    "./t3-session/ledger": "./dist/t3-session/ledger.json"
  },
  "scripts": {
    "build": "node src/t3-session/generate.mjs && node ../../scripts/compile.mjs -p tsconfig.build.json",
    "typecheck": "node ../../scripts/compile.mjs --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test:t3-session-contracts": "node --test --test-concurrency=1 --import tsx ../../test/t3-session-contracts/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "@nessie/t3-session-source": "workspace:*",
    "effect": "4.1.2"
  }
}
