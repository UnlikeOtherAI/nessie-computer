{
  "name": "@nessie/local-inference-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test:chatgpt-backend": "node --test --import tsx test/resource-proof.test.ts",
    "build": "node ../../scripts/compile.mjs -p tsconfig.build.json",
