    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "node ../../scripts/compile.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/executor-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.24"
  }
}
