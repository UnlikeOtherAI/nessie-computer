{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nessie Computer",
  "mainBinaryName": "nessie-executor-tray",
  "version": "0.1.0",
  "identifier": "com.unlikeotherai.nessie.executor.tray",
  "build": {
    "frontendDist": "../../packages/executor-console"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "status",
        "title": "Nessie Computer",
        "width": 640,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "UnlikeOtherAI",
    "copyright": "Copyright (c) 2026 UnlikeOtherAI",
    "category": "Productivity",
    "shortDescription": "Lets agents in your Nessie teams use this computer.",
    "longDescription": "Connects this computer to your Nessie teams and controls which folders, programs, websites and local apps their agents may use.",
    "icon": [
      "icons/32x32.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "signCommand": null
    }
  }
}
