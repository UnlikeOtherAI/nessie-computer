{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "//#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "//#lint": {},
    "//#test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "//#test:public-portability": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
