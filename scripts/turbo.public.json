{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#test:t3-session-control-source": { "dependsOn": [], "cache": false,
      "env": ["T3_SESSION_CONTROL_REFERENCE"] },
    "//#test:t3-session-control": { "dependsOn": ["//#build"], "cache": false },
    "//#test:t3-session-runtime": { "dependsOn": ["//#build"], "cache": false },
    "test:executor-private-assignments": { "dependsOn": ["build"], "cache": false },
    "//#test:t3-session-files": { "dependsOn": ["//#build"], "cache": false, "env": ["DATABASE_URL"] },
    "test:t3-session-source": { "dependsOn": [], "cache": false },
    "//#test:t3-session-import-source": { "dependsOn": [], "cache": false,
      "env": ["T3_SESSION_IMPORT_REFERENCE"] },
    "//#test:t3-session-import": { "dependsOn": ["//#build"], "cache": false },
    "//#test:t3-session-catalog": { "dependsOn": ["//#build"], "cache": false },
    "//#test:t3-session-request-prepare": { "dependsOn": [], "cache": false,
      "env": ["T3_REQUEST_PRIVACY_SOURCE_REPOSITORY", "T3_REQUEST_PRIVACY_SOURCE_ARCHIVE"] },
    "//#test:t3-session-request-source": { "dependsOn": [], "cache": false,
      "env": ["T3_REQUEST_PRIVACY_SOURCE_REPOSITORY", "T3_REQUEST_PRIVACY_SOURCE_ARCHIVE"] },
    "//#test:t3-session-request-fixtures": { "dependsOn": ["//#test:t3-session-request-prepare"], "cache": false,
      "env": ["T3_REQUEST_PRIVACY_SOURCE_REPOSITORY", "T3_REQUEST_PRIVACY_SOURCE_ARCHIVE"] },
    "//#test:t3-session-requests": { "dependsOn": ["//#test:t3-session-request-prepare"], "cache": false,
      "env": ["T3_REQUEST_PRIVACY_SOURCE_REPOSITORY", "T3_REQUEST_PRIVACY_SOURCE_ARCHIVE"] },
    "//#test:t3-session-engine-plugins": { "dependsOn": [], "cache": false },
    "test:t3-session-contracts": { "dependsOn": ["build"], "cache": false },
    "//#test:t3-session-client-connection": { "dependsOn": [], "cache": false,
      "env": ["T3_CLIENT_CONNECTION_SOURCE_REPOSITORY", "T3_CLIENT_CONNECTION_SOURCE_ARCHIVE"] },
    "//#test:t3-session-client-http-auth": { "dependsOn": [], "cache": false,
      "env": ["T3_CLIENT_CONNECTION_SOURCE_REPOSITORY", "T3_CLIENT_CONNECTION_SOURCE_ARCHIVE",
        "T3_CLIENT_CONNECTION_DEPENDENCY_DIRECTORY"] },
    "@nessie/t3-session-source#build": {
      "dependsOn": ["^build", "prepare:engine"],
      "inputs": ["$TURBO_DEFAULT$", "../../LICENSE", "../../packaging/session-engine/**", "../../patches/t3-session/**",
        "../../src/t3-session/requests/**",
        "!../../packaging/session-engine/node_modules/**", "!../../packaging/session-engine/.artifacts/**"],
      "outputs": ["dist/**"]
    },
    "prepare:engine": { "dependsOn": [], "cache": false },
    "@nessie/t3-session-source#typecheck": { "dependsOn": ["^build", "^typecheck", "prepare:engine"],
      "inputs": ["$TURBO_DEFAULT$", "../../packaging/session-engine/**", "../../patches/t3-session/**",
        "../../src/t3-session/requests/**",
        "!../../packaging/session-engine/node_modules/**", "!../../packaging/session-engine/.artifacts/**"] },
    "test:t3-session-engine": { "dependsOn": ["build"], "cache": false },
    "test:t3-session-client": { "dependsOn": ["build"], "cache": false },
    "test:t3-session-engine-browser": { "dependsOn": ["build"], "cache": false,
      "env": ["T3_SESSION_BROWSER_EXECUTABLE"] },
    "@nessie/t3-session-source#test": { "dependsOn": ["build"], "cache": false },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "//#build": {
      "dependsOn": [
        "^build"
      ],
