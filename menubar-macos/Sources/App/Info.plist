<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NessieSentryDSN</key>
    <string>$(NESSIE_COMPUTER_SENTRY_DSN)</string>
	<key>NessieExecutorManagedLaunchProtocol</key>
	<integer>1</integer>
	<key>NessieExecutorPersonalInferenceGuardVersion</key>
	<integer>2</integer>
	<key>NessieExecutorIndependentRuntime</key>
	<integer>1</integer>
	<key>NessieExecutorUpdateServiceProtocol</key>
	<integer>1</integer>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The bundle stays "Nessie Executor.app": the updater, the protected
	     runtime and the native custody checks verify that installed path. The
	     name a person sees is "Nessie Computer", from each language's
	     InfoPlist.strings. Finder shows a localized name only while the
	     bundle's file name matches CFBundleDisplayName here, so these two
	     keep the file name and the strings files carry the product's name. -->
	<key>CFBundleName</key>
	<string>Nessie Executor</string>
	<key>CFBundleDisplayName</key>
	<string>Nessie Executor</string>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<!-- nessie-computer:// links only navigate the window; see DeepLink. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.unlikeotherai.nessie.computer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nessie-computer</string>
			</array>
		</dict>
	</array>
	<!-- What macOS asks before a team's agents reach a protected folder or the
	     local network. Translated in each InfoPlist.strings. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Nessie Computer uses this folder only when you share it with a team or keep your documents in it.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Nessie Computer uses this folder only when you share it with a team or keep your documents in it.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Nessie Computer uses this folder only when you share it with a team or keep your documents in it.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Nessie Computer uses this drive only when you share a folder on it with a team.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Nessie Computer uses this network drive only when you share a folder on it with a team.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Nessie Computer connects to model servers and computers on your network that you set up for a team.</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Status bar only: no Dock icon, no app switcher entry. Every surface
	     this app has hangs off the menu bar icon. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Nessie</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
